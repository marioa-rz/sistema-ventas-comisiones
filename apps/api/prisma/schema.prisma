generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SELLER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProofReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum CommissionPayoutMethod {
  CASH
  TRANSFER
}

enum CommissionPayoutStatus {
  COMPLETED
  CANCELLED
}

model AppUser {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId  String   @unique @map("auth_user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(120)
  role        UserRole
  isActive    Boolean  @default(true) @map("is_active")
  bankName          String? @map("bank_name") @db.VarChar(120)
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  soldOrders            Order[]            @relation("OrderSeller")
  confirmedOrders       Order[]            @relation("OrderConfirmer")
  cancelledOrders       Order[]            @relation("OrderCanceller")
  cashReceivedPayments  Payment[]          @relation("CashReceiver")
  verifiedPayments      Payment[]          @relation("PaymentVerifier")
  reviewedPaymentProofs PaymentProof[]     @relation("ProofReviewer")
  commissions           Commission[]       @relation("CommissionSeller")
  receivedPayouts       CommissionPayout[] @relation("PayoutSeller")
  administeredPayouts   CommissionPayout[] @relation("PayoutAdministrator")
  cancelledPayouts      CommissionPayout[] @relation("PayoutCanceller")
  auditLogs             AuditLog[]

  @@index([role, isActive], map: "app_users_role_active_idx")
  @@map("app_users")
}

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(120)
  phone     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders    Order[]

  @@index([phone], map: "customers_phone_idx")
  @@map("customers")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@index([isActive, name], map: "categories_active_name_idx")
  @@map("categories")
}

model Product {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  name          String   @db.VarChar(160)
  description   String?  @db.Text
  mainImagePath String?  @map("main_image_path") @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([categoryId, isActive, name], map: "products_category_active_name_idx")
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  sku         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  price       Decimal  @db.Decimal(12, 2)
  imagePath   String?  @map("image_path") @db.Text
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([productId, isAvailable], map: "product_variants_product_available_idx")
  @@map("product_variants")
}

model Order {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicCode         String      @unique @map("public_code") @db.VarChar(16)
  idempotencyKey     String?     @unique @map("idempotency_key") @db.VarChar(128)
  customerId         String      @map("customer_id") @db.Uuid
  sellerId           String?     @map("seller_id") @db.Uuid
  status             OrderStatus @default(PENDING)
  totalAmount        Decimal     @map("total_amount") @db.Decimal(12, 2)
  commissionAmount   Decimal     @map("commission_amount") @db.Decimal(12, 2)
  assignedAt         DateTime?   @map("assigned_at") @db.Timestamptz(6)
  confirmedAt        DateTime?   @map("confirmed_at") @db.Timestamptz(6)
  confirmedById      String?     @map("confirmed_by_id") @db.Uuid
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      String?     @map("cancelled_by_id") @db.Uuid
  cancellationReason String?     @map("cancellation_reason") @db.VarChar(500)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  seller      AppUser?    @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  confirmedBy AppUser?    @relation("OrderConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  cancelledBy AppUser?    @relation("OrderCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payment     Payment?
  commission  Commission?

  @@index([sellerId, status, createdAt], map: "orders_seller_status_created_idx")
  @@index([status, createdAt], map: "orders_status_created_idx")
  @@index([status, confirmedAt], map: "orders_status_confirmed_idx")
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  productVariantId    String? @map("product_variant_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot") @db.VarChar(160)
  variantNameSnapshot String  @map("variant_name_snapshot") @db.VarChar(120)
  skuSnapshot         String  @map("sku_snapshot") @db.VarChar(64)
  unitPrice           Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity            Int
  subtotal            Decimal @db.Decimal(12, 2)
  commissionRate      Decimal @map("commission_rate") @db.Decimal(5, 4)
  commissionAmount    Decimal @map("commission_amount") @db.Decimal(12, 2)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "order_items_order_idx")
  @@index([productVariantId], map: "order_items_variant_idx")
  @@map("order_items")
}

model Payment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String        @unique @map("order_id") @db.Uuid
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  cashReceivedAt   DateTime?     @map("cash_received_at") @db.Timestamptz(6)
  cashReceivedById String?       @map("cash_received_by_id") @db.Uuid
  verifiedAt       DateTime?     @map("verified_at") @db.Timestamptz(6)
  verifiedById     String?       @map("verified_by_id") @db.Uuid
  rejectionReason  String?       @map("rejection_reason") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cashReceivedBy AppUser?       @relation("CashReceiver", fields: [cashReceivedById], references: [id], onDelete: Restrict)
  verifiedBy     AppUser?       @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  proofs         PaymentProof[]

  @@index([status, createdAt], map: "payments_status_created_idx")
  @@map("payments")
}

model PaymentProof {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String            @map("payment_id") @db.Uuid
  storagePath      String            @unique @map("storage_path") @db.Text
  originalFilename String            @map("original_filename") @db.VarChar(255)
  mimeType         String            @map("mime_type") @db.VarChar(100)
  sizeBytes        Int               @map("size_bytes")
  reviewStatus     ProofReviewStatus @default(PENDING) @map("review_status")
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewedById     String?           @map("reviewed_by_id") @db.Uuid
  rejectionReason  String?           @map("rejection_reason") @db.VarChar(500)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reviewedBy AppUser? @relation("ProofReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([paymentId, reviewStatus, createdAt], map: "payment_proofs_payment_status_idx")
  @@map("payment_proofs")
}

model CommissionPayout {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId                  String                 @map("seller_id") @db.Uuid
  amount                    Decimal                @db.Decimal(12, 2)
  paidAt                    DateTime               @map("paid_at") @db.Timestamptz(6)
  administeredById          String                 @map("administered_by_id") @db.Uuid
  method                    CommissionPayoutMethod @default(TRANSFER)
  status                    CommissionPayoutStatus @default(COMPLETED)
  bankNameSnapshot          String?                @map("bank_name_snapshot") @db.VarChar(120)
  bankAccountNumberSnapshot String?                @map("bank_account_number_snapshot") @db.VarChar(80)
  proofStoragePath          String?                @unique @map("proof_storage_path") @db.Text
  proofOriginalFilename     String?                @map("proof_original_filename") @db.VarChar(255)
  proofMimeType             String?                @map("proof_mime_type") @db.VarChar(100)
  proofSizeBytes            Int?                   @map("proof_size_bytes")
  reference                 String?                @db.VarChar(160)
  note                      String?                @db.VarChar(500)
  cancelledAt               DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelledById             String?                @map("cancelled_by_id") @db.Uuid
  cancellationReason        String?                @map("cancellation_reason") @db.VarChar(500)
  idempotencyKey            String                 @unique @map("idempotency_key") @db.VarChar(128)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  seller         AppUser                @relation("PayoutSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  administeredBy AppUser                @relation("PayoutAdministrator", fields: [administeredById], references: [id], onDelete: Restrict)
  cancelledBy    AppUser?               @relation("PayoutCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  commissions    Commission[]
  items          CommissionPayoutItem[]

  @@index([sellerId, paidAt], map: "commission_payouts_seller_paid_idx")
  @@map("commission_payouts")
}

model CommissionPayoutItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payoutId     String   @map("payout_id") @db.Uuid
  commissionId String   @map("commission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payout     CommissionPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commission Commission       @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@unique([payoutId, commissionId], map: "commission_payout_items_payout_commission_key")
  @@index([commissionId], map: "commission_payout_items_commission_idx")
  @@map("commission_payout_items")
}

model Commission {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String                   @unique @map("order_id") @db.Uuid
  sellerId    String                   @map("seller_id") @db.Uuid
  payoutId    String?                  @map("payout_id") @db.Uuid
  amount      Decimal                  @db.Decimal(12, 2)
  status      CommissionStatus         @default(PENDING)
  approvedAt  DateTime?                @map("approved_at") @db.Timestamptz(6)
  paidAt      DateTime?                @map("paid_at") @db.Timestamptz(6)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller      AppUser                  @relation("CommissionSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  payout      CommissionPayout?        @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  payoutItems CommissionPayoutItem[]

  @@index([sellerId, status, createdAt], map: "commissions_seller_status_created_idx")
  @@index([status, approvedAt], map: "commissions_status_approved_idx")
  @@index([payoutId], map: "commissions_payout_idx")
  @@map("commissions")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor AppUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt], map: "audit_logs_entity_created_idx")
  @@index([actorId, createdAt], map: "audit_logs_actor_created_idx")
  @@map("audit_logs")
}
