# Runtime: use a Supabase direct/session connection for a long-lived NestJS service.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require"

# Migrations: direct connection when IPv6 is available, otherwise Supavisor session mode.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_BACKEND_ONLY_SERVICE_ROLE_KEY"
SUPABASE_JWT_ISSUER="https://PROJECT_REF.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWKS_URL="https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_STORAGE_PRODUCT_BUCKET="product-images"
SUPABASE_STORAGE_PAYMENT_PROOF_BUCKET="payment-proofs"

NODE_ENV="development"
PORT="3000"
TRUST_PROXY_HOPS="0"
LOG_LEVEL="info"
